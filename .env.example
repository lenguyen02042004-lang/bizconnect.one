# ============================================================
#  BizConnect.One — Environment Variables TEMPLATE
#  Copy file này thành .env rồi điền thông tin thật vào
#  File .env.example này AN TOÀN để commit lên Git
# ============================================================

# --- Supabase Project ---
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"

# Anon/Public key (lấy từ Supabase > Project Settings > API)
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"

# Service Role key — SERVER ONLY, tuyệt đối không expose ra client!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Supabase Access Token (lấy từ supabase.com > Account > Access Tokens)
SUPABASE_ACCESS_TOKEN="your-access-token"

# --- Vite client-side variables ---
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"

# --- Database URLs ---
DATABASE_URL="postgresql://postgres.your-project-id:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-id:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- SePay webhook ---
# Configure SePay with HMAC-SHA256 and copy its secret here. Do not commit it.
SEPAY_WEBHOOK_SECRET="your-sepay-hmac-secret"
# Optional alternative to HMAC. Configure only one authentication method.
SEPAY_API_KEY=""
SEPAY_ACCOUNT_NUMBER="your-bank-account-number"
